<Window x:Class="Harmonica.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Harmonica.Desktop"
        Title="口琴演奏器" Width="850" Height="780" MinWidth="510" MinHeight="740" Background="#F1F2ED" Foreground="#26352F" FontFamily="Microsoft YaHei UI, Microsoft YaHei" FontSize="13" WindowStartupLocation="CenterScreen" AllowDrop="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#26352F"/><SolidColorBrush x:Key="Muted" Color="#68746E"/>
    <Style TargetType="Button"><Setter Property="Padding" Value="13,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#E5E9E2"/><Setter Property="Foreground" Value="#26352F"/><Setter Property="BorderBrush" Value="#CFD6CD"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.42"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#4A8068"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#315B49"/><Setter Property="Foreground" Value="#FCFDF9"/><Setter Property="BorderBrush" Value="#315B49"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="7,4"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,7"/><Setter Property="MinHeight" Value="32"/><Setter Property="BorderBrush" Value="#CED6CC"/><Setter Property="Background" Value="#FBFCF8"/></Style>
    <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,15,0"/></Style>
  </Window.Resources>
  <Grid x:Name="Root" Margin="22,18,22,16" Background="#F1F2ED">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="口琴演奏器" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="BrandCaption" Text="选一首曲子，让旋律有个去处。" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="CompactButton" Content="紧凑" Click="CompactClick" Margin="0,0,7,0"/><Button Content="说明" Click="HelpClick"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="LibraryColumn" Width="226"/><ColumnDefinition x:Name="GapColumn" Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="LibraryPanel" Background="#FAFBF6" BorderBrush="#D8DED3" BorderThickness="1" CornerRadius="8" Padding="12">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><TextBlock Text="我的曲库" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="LibraryCount" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></Grid>
          <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,12,0,10" ToolTip="搜索曲名" AutomationProperties.Name="搜索曲名" TextChanged="SearchChanged"/>
          <ListBox x:Name="Songs" Grid.Row="2" BorderThickness="0" Background="Transparent" SelectionChanged="SongChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="7,9"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="3" Margin="0,10,0,0"><Button x:Name="ImportButton" Content="＋ 导入 JSON / MIDI" Click="ImportClick"/><Button x:Name="FolderButton" Content="导入曲谱文件夹" Click="FolderClick" Margin="0,7,0,0"/><TextBlock Text="也可以把曲谱拖到窗口" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="SongTitle" Text="正在读取曲库…" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SongMeta" Foreground="{StaticResource Muted}" Margin="0,6,0,12"/></StackPanel>
        <Border x:Name="OverviewPanel" Grid.Row="1" CornerRadius="7" Background="#E6EBE2" Padding="9" Margin="0,0,0,13"><local:NoteOverview x:Name="Overview" Height="95"/></Border>
        <StackPanel Grid.Row="2">
          <TextBlock Text="旋律音轨" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><ComboBox x:Name="Tracks" SelectionChanged="OptionChanged" AutomationProperties.Name="旋律音轨"/>
          <Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="演奏速度" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><ComboBox x:Name="Speed" SelectionChanged="OptionChanged" AutomationProperties.Name="演奏速度"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="整体移调" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><ComboBox x:Name="Transpose" SelectionChanged="OptionChanged" AutomationProperties.Name="整体移调"/></StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,11,0,0"><CheckBox x:Name="Fold" Content="折回可演奏音域" IsChecked="True" Click="OptionClick"/><CheckBox x:Name="Trim" Content="跳过开头空白" IsChecked="True" Click="OptionClick"/></StackPanel>
          <Expander x:Name="Advanced" Header="演奏设置" Margin="0,10,0,0"><StackPanel Margin="0,7,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox x:Name="Timing" SelectionChanged="OptionChanged" AutomationProperties.Name="时序模式"/><ComboBox x:Name="Strategy" Grid.Column="2" SelectionChanged="OptionChanged" AutomationProperties.Name="重叠音优先策略"/></Grid><Button x:Name="RestoreButton" Content="恢复这首曲谱保存的速度与移调" Click="RestoreClick" Margin="0,7,0,0"/></StackPanel></Expander>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="目标窗口" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="Targets" AutomationProperties.Name="目标游戏窗口"/><Button x:Name="RefreshButton" Grid.Column="1" Content="刷新" Click="RefreshClick" Margin="7,0,0,0" Padding="10,4"/></Grid></StackPanel>
        <StackPanel Grid.Row="4" Margin="0,12,0,8"><TextBlock x:Name="CompileSummary" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/><TextBlock x:Name="Detail" Text="先试听确认旋律，再回到游戏按 F8。" TextWrapping="Wrap" Margin="0,7,0,0" MaxHeight="50"/></StackPanel>
        <StackPanel Grid.Row="5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PreviewButton" Content="本机试听" Click="PreviewClick" Margin="0,0,8,0"/><Button x:Name="PlayButton" Grid.Column="1" Content="准备演奏（3秒）" Style="{StaticResource Primary}" Click="PlayClick"/><Button x:Name="StopButton" Grid.Column="2" Content="停止" Click="StopClick" Margin="8,0,0,0"/></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StateText" Text="待命" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="开始 / 停止 " VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><ComboBox x:Name="HotkeyBox" Width="64" MinHeight="25" SelectionChanged="HotkeyChanged" AutomationProperties.Name="开始停止热键"/></StackPanel></Grid><ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Height="5" Margin="0,9,0,5" Foreground="#47785E"/><Grid><TextBlock x:Name="ProgressText" Text="00:00 / 00:00" Foreground="{StaticResource Muted}" FontSize="11"/><Button x:Name="RetryReleaseButton" Content="重试释放按键" HorizontalAlignment="Right" Visibility="Collapsed" Click="RetryReleaseClick" Padding="7,2" MinHeight="23"/></Grid></StackPanel>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="2" Text="回到游戏后按热键开始 / 停止 · 切出目标窗口后终止 · 切回不会自动继续" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,15,0,0" TextWrapping="Wrap"/>
  </Grid>
</Window>
